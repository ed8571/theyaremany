<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- The master's own rifle: a one-of-a-kind pulse weapon. Never generated,
       never traded, never crafted. It exists once -
       in the hands of the master, and afterwards in yours. -->
  <ThingDef ParentName="Gun_ChargeRifle">
    <defName>TheyAreMany_TheMastersRifle</defName>
    <label>the master's rifle</label>
    <description>A pulse-charge rifle of no pattern any armory or trade city produces: finer than anything a trade city can put together, and probably older than its owner is honest about. Glyphs run along the stock, one word repeated with the patience of a tally - over, and over, and over.

There was only ever one. The vats issue men, not rifles: whatever cradles the facility builds next will not carry this pattern. The first clone was drained only a few years ago, and the rifle has not left his shoulder since that day. It belongs to whoever is still standing after him.</description>
    <techLevel>Archotech</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ChargeRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.58, 0.76, 0.82)</color>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.75</AccuracyTouch>
      <AccuracyShort>0.84</AccuracyShort>
      <AccuracyMedium>0.72</AccuracyMedium>
      <AccuracyLong>0.62</AccuracyLong>
      <RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
    </statBases>
    <!-- Unique-weapon comp chain (mirrors vanilla Gun_ChargeRifle_Unique). -->
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable" />
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li Class="CompProperties_Biocodable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="CompProperties_UniqueWeapon">
        <weaponCategories>
          <li>Ranged</li>
          <li>Gun</li>
          <li>Sighted</li>
          <li>Rifle</li>
          <li>BurstFire</li>
          <li>LowStoppingPower</li>
          <li>PulseCharge</li>
          <li>Attachable</li>
        </weaponCategories>
        <namerLabels>
          <li>pulse-charge rifle</li>
          <li>pulse rifle</li>
        </namerLabels>
      </li>
    </comps>
    <weaponTags Inherit="False" IsNull="True" />
    <tradeTags Inherit="False" IsNull="True" />
    <thingSetMakerTags Inherit="False" IsNull="True" />
    <recipeMaker Inherit="False" IsNull="True" />
    <smeltable>false</smeltable>
    <thingCategories Inherit="False">
      <li>WeaponsUnique</li>
    </thingCategories>
    <verbs Inherit="False">
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>TheyAreMany_Bullet_TheMastersRifle</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>35.9</range>
        <ticksBetweenBurstShots>9</ticksBetweenBurstShots>
        <burstShotCount>5</burstShotCount>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>TheyAreMany_Bullet_TheMastersRifle</defName>
    <label>pulse-charge shot</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.58, 0.76, 0.82)</color>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <armorPenetrationBase>0.55</armorPenetrationBase>
      <speed>85</speed>
    </projectile>
  </ThingDef>

</Defs>
